+/// Classifies a smashline git revision (7 to 40 hex chars, lowercase) found in a module.
+pub(super) fn classify(rev: &str) -> Option<super::Abi> {
+    let matches = |known: &&str| {
+        let n = rev.len().min(known.len());
+        n >= 7 && rev[..n] == known[..n]
+    };
+    if NEW_ABI_REVS.iter().any(matches) {
+        Some(super::Abi::New)
+    } else if OLD_ABI_REVS.iter().any(matches) {
+        Some(super::Abi::Old)
+    } else {
+        None
+    }
+}
