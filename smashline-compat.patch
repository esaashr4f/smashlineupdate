@@ -0,0 +1,926 @@
+//! # smashline-compat
+//!
+//! Lets movesets built against the pre-2.0 smashline API (<= 1.6.8) run on smashline 2.0.
+//!
+//! Three exported functions changed their signature or meaning in 2.0
+//! (commit d9bee02, "experiments part 1"):
+//!
+//! | function                                | <= 1.6.8                                              | 2.0                                                     |
+//! |-----------------------------------------|-------------------------------------------------------|---------------------------------------------------------|
+//! | `smashline_clone_weapon`                | `(orig_owner: str, orig_kind: i32, new_owner: str, new_name: str, use_original_code: bool) -> i32` | `(owner: str, name: str, orig_kind: i32, use_original_code: bool) -> CloneWeapon` |
+//! | `smashline_update_weapon_count`         | `(weapon_kind: i32, count: i32)`                      | `(fighter_kind: i32, generate_article_id: i32, count: i32)` |
+//! | `smashline_whitelist_kirby_copy_article`| `(fighter_kind: i32, weapon_kind: i32)`               | `(fighter_kind: i32, generate_article_id: i32)`         |
+//!
+//! Movesets look these up by name at runtime (`nn::ro::LookupSymbol`), so old and new movesets
+//! call the very same symbols. The exported symbols below are tiny assembly stubs that capture
+//! the caller's return address and hand everything to a dispatcher, which works out which ABI
+//! the caller uses:
+//!
+//! * `clone_weapon`: from the register shape alone. Strings are `{ptr, len}` pairs in two
+//!   registers, so `x3` holds a pointer for old callers (the new owner string) and a short
+//!   length for new callers (the article name). That is unambiguous.
+//! * `update_weapon_count` / `whitelist_kirby_copy_article`: the arguments are all small
+//!   integers, so the *calling module* is classified instead (first match wins):
+//!   1. an override in `sd:/ultimate/smashline_compat.txt`
+//!   2. the ABI that module used for `clone_weapon`
+//!   3. the smashline git revision embedded in the module (panic location paths contain
+//!      `.../git/checkouts/smashline-<hash>/<rev>/crates/smashline/...`)
+//!   4. 2.0-only API names in the module's rodata
+//!   5. argument plausibility, defaulting to the old ABI when both readings are plausible
+//!
+//! Old callers then get 1.6.8 behaviour on top of the 2.0 implementation:
+//! * `clone_weapon` returns the old 0-based index, so `GENERATE_ARTICLE_X = vanilla + index` works;
+//!   cloning the same original weapon onto the same fighter twice returns the first index, as on 1.6.8;
+//! * clone params are always remapped (`param_<original>` -> `param_<clone>`), as on 1.6.8;
+//! * the 2.0 warning popups are written to the log instead of being shown;
+//! * weapon counts and the Kirby whitelist are keyed by weapon kind and apply to vanilla articles
+//!   of that kind and to the old-style clones made from it;
+//! * on 1.6.8 a clone kept the *original* weapon kind. In 2.0 it gets a new one. For old modules
+//!   only, their imports of `app::utility::get_kind` and `app::sv_battle_object::kind` are
+//!   redirected so that their clones report the original kind again. Nothing in the game itself
+//!   is hooked for this; other modules are unaffected.
+//!
+//! Everything is logged to `sd:/ultimate/smashline_compat.log`.
+
+use std::{
+    collections::BTreeMap,
+    io::Write,
+    ops::Range,
+    sync::{
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Once,
+    },
+};
+
+use locks::{Mutex, RwLock};
+use rtld::Section;
+use smashline::CloneWeapon;
+
+use crate::{
+    cloning::{
+        fighters::descriptors::{ArticleDescriptor, MAX_GENERATE_ARTICLE_IDS, NEW_ARTICLES},
+        weapons::{try_get_new_agent, NewAgent, NEW_AGENTS, VANILLA_WEAPON_COUNT},
+    },
+    create_agent::{LOWERCASE_FIGHTER_NAMES, LOWERCASE_WEAPON_NAMES, LOWERCASE_WEAPON_OWNER_NAMES},
+};
+
+mod revs;
+
+pub const COMPAT_VERSION: &str = "1";
+
+const LOG_PATH: &str = "sd:/ultimate/smashline_compat.log";
+const CONFIG_PATH: &str = "sd:/ultimate/smashline_compat.txt";
+
+/// Names that only exist in the 2.0 API. A module that looks any of these up was built for 2.0.
+const NEW_ONLY_NAMES: &[&str] = &[
+    "smashline_clone_article_descriptor",
+    "smashline_enable_weapon_module",
+    "smashline_get_original_fighter_vtable",
+    "smashline_get_original_weapon_vtable",
+    "smashline_replace_fighter_vtable",
+    "smashline_replace_weapon_vtable",
+    "smashline_replace_article_descriptor_func",
+    "smashline_set_weapon_module_factory",
+    "smashline_set_weapon_lvd_nodes",
+    "smashline_load_weapon_lvd",
+    "smashline_refresh_weapon_lvd",
+];
+
+const GET_KIND_SYMBOL: &str = "_ZN3app7utility8get_kindEPKNS_26BattleObjectModuleAccessorE";
+const SV_KIND_SYMBOL: &str = "_ZN3app16sv_battle_object4kindEj";
+
+const BATTLE_OBJECT_CATEGORY_WEAPON: u32 = 1;
+
+// ---------------------------------------------------------------------------------------------
+// Logging and config
+// ---------------------------------------------------------------------------------------------
+
+static INIT: Once = Once::new();
+static LOG_FILE: Mutex<Option<std::fs::File>> = Mutex::new(None);
+
+struct Config {
+    /// (lowercase name fragment, forced abi)
+    overrides: Vec<(String, Abi)>,
+    kind_remap: bool,
+}
+
+static CONFIG: RwLock<Config> = RwLock::new(Config {
+    overrides: Vec::new(),
+    kind_remap: true,
+});
+
+fn ensure_init() {
+    INIT.call_once(|| {
+        if let Ok(file) = std::fs::File::create(LOG_PATH) {
+            *LOG_FILE.lock() = Some(file);
+        }
+        log(format!(
+            "smashline {} + compat layer {} (runs <=1.6.8 and 2.0 movesets)",
+            env!("CARGO_PKG_VERSION"),
+            COMPAT_VERSION
+        ));
+        load_config();
+    });
+}
+
+/// Writes a line to the skyline logger and to `sd:/ultimate/smashline_compat.log`.
+pub fn log(message: impl AsRef<str>) {
+    let message = message.as_ref();
+    println!("[smashline::compat] {}", message);
+    if let Some(file) = LOG_FILE.lock().as_mut() {
+        let _ = writeln!(file, "{}", message);
+        let _ = file.flush();
+    }
+}
+
+fn load_config() {
+    let Ok(text) = std::fs::read_to_string(CONFIG_PATH) else {
+        log(format!("no {} (optional), using automatic detection only", CONFIG_PATH));
+        return;
+    };
+
+    let mut config = CONFIG.write();
+    for (number, line) in text.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() {
+            continue;
+        }
+        let mut parts = line.splitn(2, char::is_whitespace);
+        let key = parts.next().unwrap_or("").to_ascii_lowercase();
+        let value = parts.next().unwrap_or("").trim().to_ascii_lowercase();
+        match (key.as_str(), value.as_str()) {
+            ("old", name) if !name.is_empty() => config.overrides.push((name.to_string(), Abi::Old)),
+            ("new", name) if !name.is_empty() => config.overrides.push((name.to_string(), Abi::New)),
+            ("kind_remap", "off") => config.kind_remap = false,
+            ("kind_remap", "on") => config.kind_remap = true,
+            // log() never touches CONFIG, so logging while holding the lock is fine
+            _ => log(format!("config line {} not understood, ignored: '{}'", number + 1, line)),
+        }
+    }
+    let summary = format!(
+        "config loaded: {} override(s) {:?}, kind_remap {}",
+        config.overrides.len(),
+        config.overrides,
+        if config.kind_remap { "on" } else { "off" }
+    );
+    drop(config);
+    log(summary);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Calling-module registry
+// ---------------------------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Abi {
+    Old,
+    New,
+    Unknown,
+}
+
+struct ModuleEntry {
+    text: Range<u64>,
+    name: String,
+    abi: Abi,
+    reason: String,
+    forced: bool,
+    kind_patched: bool,
+}
+
+static MODULES: RwLock<Vec<ModuleEntry>> = RwLock::new(Vec::new());
+
+/// Description of a calling module for log lines.
+fn describe(index: Option<usize>, lr: u64) -> String {
+    match index {
+        Some(index) => {
+            let modules = MODULES.read();
+            let module = &modules[index];
+            format!("'{}' (+{:#x})", module.name, lr.wrapping_sub(module.text.start))
+        }
+        None => format!("unknown module (lr {:#x})", lr),
+    }
+}
+
+/// Finds (classifying on first sight) the module whose code contains `lr`.
+fn module_index(lr: u64) -> Option<usize> {
+    if let Some(index) = MODULES.read().iter().position(|m| m.text.contains(&lr)) {
+        return Some(index);
+    }
+
+    // Normally the caller is in nn::ro's module lists. A plugin whose start-up code runs before
+    // it has been added there is found through the memory map instead (same layout: text,
+    // then rodata directly after it).
+    let (text, rodata, name) = match rtld::find_module_for_address(lr, Section::Text) {
+        Some(module) => {
+            let text = module.get_address_range(Section::Text);
+            let name = module
+                .get_module_name()
+                .map(|name| name.to_string())
+                .unwrap_or_else(|| format!("unnamed@{:#x}", text.start));
+            (text, module.get_address_range(Section::RoData), name)
+        }
+        None => {
+            let info = rtld::nx::query_memory(lr);
+            // perm bit 2 = executable
+            if info.perm & 0x4 == 0 || info.size == 0 {
+                return None;
+            }
+            let text = info.addr..info.addr + info.size;
+            let ro = rtld::nx::query_memory(text.end);
+            let rodata = text.end..text.end + ro.size;
+            let name = read_module_name(&rodata).unwrap_or_else(|| format!("unlisted@{:#x}", text.start));
+            (text, rodata, name)
+        }
+    };
+
+    let (abi, reason, forced) = classify_static(&rodata, &name);
+
+    let mut modules = MODULES.write();
+    if let Some(index) = modules.iter().position(|m| m.text.contains(&lr)) {
+        return Some(index);
+    }
+    log(format!("module '{}' classified as {:?}: {}", name, abi, reason));
+    modules.push(ModuleEntry {
+        text,
+        name,
+        abi,
+        reason,
+        forced,
+        kind_patched: false,
+    });
+    let index = modules.len() - 1;
+    drop(modules);
+
+    if abi == Abi::Old {
+        ensure_kind_patch(index);
+    }
+    Some(index)
+}
+
+fn module_abi(index: Option<usize>) -> Abi {
+    index.map_or(Abi::Unknown, |index| MODULES.read()[index].abi)
+}
+
+/// Records the ABI a module was seen using for `clone_weapon` (unless the config forces one).
+fn note_observed(index: Option<usize>, abi: Abi) {
+    let Some(index) = index else { return };
+    let mut modules = MODULES.write();
+    let module = &mut modules[index];
+    if module.forced || module.abi == abi {
+        return;
+    }
+    let message = format!(
+        "module '{}' reclassified {:?} -> {:?} (it called clone_weapon with the {:?} signature; was: {})",
+        module.name, module.abi, abi, abi, module.reason
+    );
+    module.abi = abi;
+    module.reason = "observed clone_weapon signature".to_string();
+    drop(modules);
+    log(message);
+    if abi == Abi::Old {
+        ensure_kind_patch(index);
+    }
+}
+
+/// Same as `rtld::ModuleObject::get_module_name`, from the rodata range alone.
+fn read_module_name(rodata: &Range<u64>) -> Option<String> {
+    let info = rtld::nx::query_memory(rodata.start);
+    if info.perm & 1 == 0 || rodata.end < rodata.start + 8 {
+        return None;
+    }
+    unsafe {
+        if *(rodata.start as *const u32) != 0 {
+            return None;
+        }
+        let length = *((rodata.start + 4) as *const i32);
+        if length <= 0 || length > 0x200 || rodata.start + 8 + length as u64 > rodata.end {
+            return None;
+        }
+        let bytes = std::slice::from_raw_parts((rodata.start + 8) as *const u8, length as usize);
+        let path = std::str::from_utf8(bytes).ok()?;
+        let name = path.rsplit(|c| c == '/' || c == '\\').next()?;
+        Some(name.trim_end_matches('\0').to_string())
+    }
+}
+
+fn classify_static(rodata: &Range<u64>, name: &str) -> (Abi, String, bool) {
+    let lowercase = name.to_ascii_lowercase();
+    for (fragment, abi) in CONFIG.read().overrides.iter() {
+        if lowercase.contains(fragment.as_str()) {
+            return (*abi, format!("forced by {} ('{}')", CONFIG_PATH, fragment), true);
+        }
+    }
+
+    let rodata = rodata.clone();
+    let info = rtld::nx::query_memory(rodata.start);
+    if info.perm & 1 == 0 || rodata.end <= rodata.start {
+        return (Abi::Unknown, "rodata not readable".to_string(), false);
+    }
+    let bytes = unsafe {
+        std::slice::from_raw_parts(rodata.start as *const u8, (rodata.end - rodata.start) as usize)
+    };
+
+    // `install_symbol_hook` is declared in the smashline API crate but no smashline plugin has
+    // ever exported it, so a call to it fails on every version. Plugins are linked with
+    // --no-gc-sections, so without LTO every declared import name stays in the binary whether it
+    // is called or not; its presence is usually harmless. Note it for diagnosis.
+    if contains(bytes, b"smashline_install_symbol_hook") {
+        log(format!(
+            "note: module '{}' contains the name smashline_install_symbol_hook (usually just an unused declaration). No smashline release has ever provided it; if the module really calls it, it panics with \"Could not find 'smashline_install_symbol_hook'\"",
+            name
+        ));
+    }
+
+    let mut unknown_revs = Vec::new();
+    let mut old_revs = Vec::new();
+    let mut new_revs = Vec::new();
+    for rev in find_smashline_revs(bytes) {
+        match revs::classify(&rev) {
+            Some(Abi::New) => new_revs.push(rev),
+            Some(_) => old_revs.push(rev),
+            None => unknown_revs.push(rev),
+        }
+    }
+    dedup(&mut old_revs);
+    dedup(&mut new_revs);
+    dedup(&mut unknown_revs);
+
+    match (old_revs.is_empty(), new_revs.is_empty()) {
+        (false, true) => return (Abi::Old, format!("built with smashline rev {:?} (pre-2.0 API)", old_revs), false),
+        (true, false) => return (Abi::New, format!("built with smashline rev {:?} (2.0 API)", new_revs), false),
+        (false, false) => {
+            log(format!(
+                "module '{}' contains both pre-2.0 revs {:?} and 2.0 revs {:?}; ignoring revisions",
+                name, old_revs, new_revs
+            ));
+        }
+        (true, true) => {}
+    }
+
+    if let Some(api) = NEW_ONLY_NAMES.iter().find(|api| contains(bytes, api.as_bytes())) {
+        return (Abi::New, format!("uses 2.0-only API {}", api), false);
+    }
+
+    let reason = if unknown_revs.is_empty() {
+        "no smashline revision or 2.0-only API found".to_string()
+    } else {
+        format!("smashline rev {:?} not known to this build (fork or newer)", unknown_revs)
+    };
+    (Abi::Unknown, reason, false)
+}
+
+fn dedup(list: &mut Vec<String>) {
+    list.sort();
+    list.dedup();
+}
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    !needle.is_empty() && haystack.windows(needle.len()).any(|window| window == needle)
+}
+
+/// Finds `checkouts/smashline[-anything]-<16 hex>/<rev>/` (either slash direction) in `bytes`
+/// and returns the revisions.
+fn find_smashline_revs(bytes: &[u8]) -> Vec<String> {
+    const MARKER: &[u8] = b"checkouts";
+    let is_sep = |b: u8| b == b'/' || b == b'\\';
+    let mut out = Vec::new();
+    let mut start = 0;
+    while let Some(offset) = bytes[start..].windows(MARKER.len()).position(|w| w == MARKER) {
+        let mut cursor = start + offset + MARKER.len();
+        start = cursor;
+        if cursor >= bytes.len() || !is_sep(bytes[cursor]) {
+            continue;
+        }
+        cursor += 1;
+        // checkout directory: smashline-<16 hex> (also matches e.g. smashline-2-<16 hex>)
+        let dir_start = cursor;
+        while cursor < bytes.len() && !is_sep(bytes[cursor]) && bytes[cursor] > 0x20 && cursor - dir_start < 128 {
+            cursor += 1;
+        }
+        let Ok(dir) = std::str::from_utf8(&bytes[dir_start..cursor]) else { continue };
+        let Some((crate_name, hash)) = dir.rsplit_once('-') else { continue };
+        if !crate_name.starts_with("smashline")
+            || hash.len() != 16
+            || !hash.bytes().all(|b| b.is_ascii_hexdigit())
+        {
+            continue;
+        }
+        if cursor >= bytes.len() || !is_sep(bytes[cursor]) {
+            continue;
+        }
+        cursor += 1;
+        let rev_start = cursor;
+        while cursor < bytes.len() && bytes[cursor].is_ascii_hexdigit() && cursor - rev_start < 40 {
+            cursor += 1;
+        }
+        if cursor - rev_start >= 7 && cursor < bytes.len() && is_sep(bytes[cursor]) {
+            out.push(String::from_utf8_lossy(&bytes[rev_start..cursor]).to_ascii_lowercase());
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------------
+// Weapon kind emulation for old modules (1.6.8 clones kept the original weapon kind)
+// ---------------------------------------------------------------------------------------------
+
+static REAL_GET_KIND: AtomicUsize = AtomicUsize::new(0);
+static REAL_SV_KIND: AtomicUsize = AtomicUsize::new(0);
+static KIND_TARGETS_RESOLVED: AtomicBool = AtomicBool::new(false);
+static KIND_PATCH_PENDING: AtomicBool = AtomicBool::new(false);
+
+/// Called after every module load (see `nro_hook`): installs kind emulation for old modules
+/// that were still loading when they were classified.
+pub fn retry_pending_kind_patches() {
+    if !KIND_PATCH_PENDING.swap(false, Ordering::AcqRel) {
+        return;
+    }
+    let pending: Vec<usize> = MODULES
+        .read()
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| m.abi == Abi::Old && !m.kind_patched)
+        .map(|(i, _)| i)
+        .collect();
+    for index in pending {
+        ensure_kind_patch(index);
+    }
+}
+
+fn resolve_kind_targets() -> bool {
+    if KIND_TARGETS_RESOLVED.load(Ordering::Acquire) {
+        return REAL_GET_KIND.load(Ordering::Acquire) != 0;
+    }
+    let main_text = unsafe { skyline::hooks::getRegionAddress(skyline::hooks::Region::Text) } as u64;
+    let mut found = false;
+    if let Some(main) = rtld::find_module_for_address(main_text, Section::Text) {
+        if let Some(ptr) = main.get_symbol_ptr_by_name(GET_KIND_SYMBOL) {
+            REAL_GET_KIND.store(ptr as usize, Ordering::Release);
+            found = true;
+        }
+        if let Some(ptr) = main.get_symbol_ptr_by_name(SV_KIND_SYMBOL) {
+            REAL_SV_KIND.store(ptr as usize, Ordering::Release);
+        }
+    }
+    if !found {
+        log("could not resolve app::utility::get_kind in the game; weapon kind emulation disabled");
+    }
+    KIND_TARGETS_RESOLVED.store(true, Ordering::Release);
+    found
+}
+
+/// Original kind of `kind` if it is a clone registered through the old ABI.
+fn legacy_origin_in(agents: &Vec<NewAgent>, kind: i32) -> Option<i32> {
+    try_get_new_agent(agents, kind)
+        .filter(|agent| agent.legacy)
+        .map(|agent| agent.original_article_id)
+}
+
+fn legacy_origin(kind: i32) -> Option<i32> {
+    if kind < VANILLA_WEAPON_COUNT as i32 {
+        return None;
+    }
+    legacy_origin_in(&NEW_AGENTS.read(), kind)
+}
+
+unsafe extern "C" fn legacy_get_kind(module_accessor: *const u8) -> i32 {
+    let real: unsafe extern "C" fn(*const u8) -> i32 =
+        std::mem::transmute(REAL_GET_KIND.load(Ordering::Relaxed));
+    let kind = real(module_accessor);
+    if kind < VANILLA_WEAPON_COUNT as i32 || module_accessor.is_null() {
+        return kind;
+    }
+    // BattleObjectModuleAccessor + 0x8 = battle object id; category is the top nibble.
+    let id = *(module_accessor.add(8) as *const u32);
+    if id >> 28 != BATTLE_OBJECT_CATEGORY_WEAPON {
+        return kind;
+    }
+    legacy_origin(kind).unwrap_or(kind)
+}
+
+unsafe extern "C" fn legacy_sv_kind(id: u32) -> i32 {
+    let real: unsafe extern "C" fn(u32) -> i32 =
+        std::mem::transmute(REAL_SV_KIND.load(Ordering::Relaxed));
+    let kind = real(id);
+    if kind < VANILLA_WEAPON_COUNT as i32 || id >> 28 != BATTLE_OBJECT_CATEGORY_WEAPON {
+        return kind;
+    }
+    legacy_origin(kind).unwrap_or(kind)
+}
+
+fn ensure_kind_patch(index: usize) {
+    if !CONFIG.read().kind_remap {
+        return;
+    }
+    let (text_start, name) = {
+        let mut modules = MODULES.write();
+        let module = &mut modules[index];
+        if module.kind_patched {
+            return;
+        }
+        module.kind_patched = true;
+        (module.text.start, module.name.clone())
+    };
+    if !resolve_kind_targets() {
+        return;
+    }
+    let Some(module) = rtld::find_module_for_address(text_start, Section::Text) else {
+        // Not in nn::ro's lists yet (still loading); retried after the next module load.
+        MODULES.write()[index].kind_patched = false;
+        KIND_PATCH_PENDING.store(true, Ordering::Release);
+        log(format!("module '{}': not registered with nn::ro yet, weapon kind emulation will be installed after it finishes loading", name));
+        return;
+    };
+    let (get_kind, get_kind_ro) = module.patch_imports(legacy_get_kind as *const (), GET_KIND_SYMBOL);
+    let (sv_kind, sv_kind_ro) = if REAL_SV_KIND.load(Ordering::Acquire) != 0 {
+        module.patch_imports(legacy_sv_kind as *const (), SV_KIND_SYMBOL)
+    } else {
+        (0, 0)
+    };
+    log(format!(
+        "module '{}': weapon kind emulation installed (utility::get_kind: {} import slot(s){}, sv_battle_object::kind: {} slot(s){})",
+        name,
+        get_kind,
+        if get_kind_ro > 0 { format!(", {} read-only skipped", get_kind_ro) } else { String::new() },
+        sv_kind,
+        if sv_kind_ro > 0 { format!(", {} read-only skipped", sv_kind_ro) } else { String::new() },
+    ));
+}
+
+// ---------------------------------------------------------------------------------------------
+// State for old-ABI calls, used by cloning::fighters::descriptors
+// ---------------------------------------------------------------------------------------------
+
+/// Old `update_weapon_count(weapon_kind, count)` calls.
+static LEGACY_WEAPON_COUNT: RwLock<BTreeMap<i32, i32>> = RwLock::new(BTreeMap::new());
+/// Old `whitelist_kirby_copy_article(fighter_kind, weapon_kind)` calls.
+static LEGACY_KIRBY_WHITELIST: RwLock<BTreeMap<i32, Vec<i32>>> = RwLock::new(BTreeMap::new());
+
+/// Applies old-style counts to weapon rows whose kind (or, for old-style clones, original kind)
+/// matches. Item rows are left alone.
+pub fn apply_legacy_weapon_counts(descriptors: &mut [ArticleDescriptor]) {
+    let counts = LEGACY_WEAPON_COUNT.read();
+    if counts.is_empty() {
+        return;
+    }
+    let agents = NEW_AGENTS.read();
+    for descriptor in descriptors.iter_mut() {
+        if descriptor.extra & 1 != 0 {
+            continue;
+        }
+        let count = counts.get(&descriptor.weapon_id).or_else(|| {
+            legacy_origin_in(&agents, descriptor.weapon_id).and_then(|origin| counts.get(&origin))
+        });
+        if let Some(count) = count {
+            descriptor.max_count = *count;
+        }
+    }
+}
+
+pub fn legacy_kirby_whitelist(fighter_kind: i32) -> Option<Vec<i32>> {
+    LEGACY_KIRBY_WHITELIST.read().get(&fighter_kind).cloned()
+}
+
+pub fn weapon_matches_legacy_kinds(weapon_id: i32, kinds: &[i32]) -> bool {
+    kinds.contains(&weapon_id) || legacy_origin(weapon_id).map_or(false, |origin| kinds.contains(&origin))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Argument helpers
+// ---------------------------------------------------------------------------------------------
+
+fn looks_like_ptr(value: u64) -> bool {
+    (0x10000..(1u64 << 48)).contains(&value)
+}
+
+fn looks_like_len(value: u64) -> bool {
+    value > 0 && value < 0x1000
+}
+
+/// Reads a `{ptr, len}` string argument, checking that the memory is mapped and readable first
+/// so that a bad call produces a readable panic instead of a data abort.
+fn read_str(ptr: u64, len: u64, what: &str, caller: &str) -> String {
+    if len == 0 {
+        return String::new();
+    }
+    let info = rtld::nx::query_memory(ptr);
+    let readable = info.perm & 1 != 0 && ptr >= info.addr && ptr.saturating_add(len) <= info.addr + info.size;
+    if !looks_like_ptr(ptr) || !readable || len > 0x1000 {
+        log(format!("bad string for {} from {}: ptr {:#x} len {:#x}", what, caller, ptr, len));
+        panic!("[compat] {} passed a bad string for {} (ptr {:#x}, len {:#x})", caller, what, ptr, len);
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(ptr as *const u8, len as usize) };
+    match std::str::from_utf8(bytes) {
+        Ok(s) => s.to_string(),
+        Err(_) => {
+            log(format!("non-UTF-8 string for {} from {}", what, caller));
+            panic!("[compat] {} passed a non-UTF-8 string for {}", caller, what);
+        }
+    }
+}
+
+fn fighter_id(name: &str) -> Option<i32> {
+    LOWERCASE_FIGHTER_NAMES.iter().position(|n| n == name).map(|i| i as i32)
+}
+
+fn weapon_label(kind: i32) -> String {
+    match (
+        LOWERCASE_WEAPON_OWNER_NAMES.get(kind as usize),
+        LOWERCASE_WEAPON_NAMES.get(kind as usize),
+    ) {
+        (Some(owner), Some(name)) if kind >= 0 => format!("{}_{} ({:#x})", owner, name, kind),
+        _ => format!("{:#x}", kind),
+    }
+}
+
+fn clones_on(fighter_kind: i32) -> i32 {
+    NEW_ARTICLES.read().get(&fighter_kind).map_or(0, |list| list.len() as i32)
+}
+
+/// Could `(fighter_kind, generate_article_id)` be a 2.0 call?
+fn plausible_generate_id(fighter_kind: i32, generate_article_id: i32) -> bool {
+    let Some(max) = MAX_GENERATE_ARTICLE_IDS.get(fighter_kind as usize) else {
+        return false;
+    };
+    fighter_kind >= 0 && generate_article_id >= 0 && generate_article_id <= *max + clones_on(fighter_kind)
+}
+
+fn plausible_count(count: i32) -> bool {
+    (-1..=1000).contains(&count)
+}
+
+fn plausible_weapon_kind(kind: i32) -> bool {
+    (0..VANILLA_WEAPON_COUNT as i32).contains(&kind)
+}
+
+// ---------------------------------------------------------------------------------------------
+// smashline_clone_weapon
+// ---------------------------------------------------------------------------------------------
+
+/// Exported entry point. The return address is passed to the dispatcher as its 9th argument
+/// (on the stack), since the old ABI uses all of x0-x7.
+#[unsafe(naked)]
+#[no_mangle]
+pub unsafe extern "C" fn smashline_clone_weapon() {
+    core::arch::naked_asm!(
+        "sub sp, sp, #16",
+        "str x30, [sp]",
+        "bl {dispatch}",
+        "ldr x30, [sp]",
+        "add sp, sp, #16",
+        "ret",
+        dispatch = sym clone_weapon_dispatch,
+    );
+}
+
+extern "C" fn clone_weapon_dispatch(
+    x0: u64,
+    x1: u64,
+    x2: u64,
+    x3: u64,
+    x4: u64,
+    x5: u64,
+    x6: u64,
+    x7: u64,
+    lr: u64,
+) -> u64 {
+    ensure_init();
+    let index = module_index(lr);
+    let caller = describe(index, lr);
+
+    // old: x0,x1 orig owner | w2 orig kind | x3,x4 new owner | x5,x6 new name | w7 bool
+    // new: x0,x1 owner      | x2,x3 name   | w4 orig kind    | w5 bool
+    let old_shape = looks_like_ptr(x0)
+        && looks_like_len(x1)
+        && plausible_weapon_kind(x2 as u32 as i32)
+        && looks_like_ptr(x3)
+        && looks_like_len(x4)
+        && looks_like_ptr(x5)
+        && looks_like_len(x6);
+    let new_shape = looks_like_ptr(x0)
+        && looks_like_len(x1)
+        && looks_like_ptr(x2)
+        && looks_like_len(x3)
+        && plausible_weapon_kind(x4 as u32 as i32);
+
+    let abi = match (old_shape, new_shape) {
+        (true, false) => Abi::Old,
+        (false, true) => Abi::New,
+        _ => {
+            let fallback = module_abi(index);
+            log(format!(
+                "clone_weapon from {}: unrecognised argument shape (x0..x7 = {:#x} {:#x} {:#x} {:#x} {:#x} {:#x} {:#x} {:#x}); module is {:?}",
+                caller, x0, x1, x2, x3, x4, x5, x6, x7, fallback
+            ));
+            if fallback == Abi::Unknown {
+                panic!("[compat] clone_weapon called by {} with arguments matching neither the old nor the 2.0 signature", caller);
+            }
+            fallback
+        }
+    };
+    note_observed(index, abi);
+
+    match abi {
+        Abi::Old => {
+            let original_owner = read_str(x0, x1, "original owner", &caller);
+            let original_kind = x2 as u32 as i32;
+            let new_owner = read_str(x3, x4, "new owner", &caller);
+            let new_name = read_str(x5, x6, "new name", &caller);
+            let use_original_code = x7 as u8 != 0;
+            legacy_clone_weapon(&caller, original_owner, original_kind, new_owner, new_name, use_original_code)
+                as u32 as u64
+        }
+        _ => {
+            let owner = read_str(x0, x1, "owner", &caller);
+            let name = read_str(x2, x3, "article name", &caller);
+            let original_kind = x4 as u32 as i32;
+            let use_original_code = x5 as u8 != 0;
+            log(format!(
+                "clone_weapon [2.0] from {}: {}_{} from {} use_original_code={}",
+                caller, owner, name, weapon_label(original_kind), use_original_code
+            ));
+            let result = crate::api::clone_weapon_impl(owner, name, original_kind, use_original_code, false);
+            log(format!(
+                "  -> weapon id {:#x}, generate id {}",
+                result.weapon_id, result.generate_id
+            ));
+            pack_clone_weapon(result)
+        }
+    }
+}
+
+/// `CloneWeapon` is `#[repr(C)] { generate_id: i32, weapon_id: i32 }`: 8 bytes, returned in x0.
+fn pack_clone_weapon(result: CloneWeapon) -> u64 {
+    (result.generate_id as u32 as u64) | ((result.weapon_id as u32 as u64) << 32)
+}
+
+fn legacy_clone_weapon(
+    caller: &str,
+    original_owner: String,
+    original_kind: i32,
+    new_owner: String,
+    new_name: String,
+    use_original_code: bool,
+) -> i32 {
+    log(format!(
+        "clone_weapon [pre-2.0] from {}: {} weapon {} -> {}_{} use_original_code={}",
+        caller, original_owner, weapon_label(original_kind), new_owner, new_name, use_original_code
+    ));
+
+    if !plausible_weapon_kind(original_kind) {
+        panic!("[compat] {} cloned an invalid weapon kind {:#x}", caller, original_kind);
+    }
+    let actual_owner = LOWERCASE_WEAPON_OWNER_NAMES.get(original_kind as usize).unwrap();
+    if actual_owner != original_owner {
+        log(format!(
+            "  note: weapon {} belongs to '{}', not '{}'; using '{}'",
+            weapon_label(original_kind), actual_owner, original_owner, actual_owner
+        ));
+    }
+    let Some(owner_id) = fighter_id(&new_owner) else {
+        panic!("[compat] {} cloned onto unknown fighter '{}'", caller, new_owner);
+    };
+    let Some(max_generate_id) = MAX_GENERATE_ARTICLE_IDS.get(owner_id as usize).copied() else {
+        panic!("[compat] {} cloned onto fighter '{}' ({:#x}), which cannot own clones", caller, new_owner, owner_id);
+    };
+
+    // 1.6.8: cloning the same original weapon onto the same fighter again returned the first index.
+    let existing = NEW_ARTICLES.read().get(&owner_id).and_then(|articles| {
+        articles
+            .iter()
+            .position(|a| a.legacy && !a.skip_patching && a.original_weapon_id == original_kind)
+    });
+    if let Some(existing) = existing {
+        log(format!(
+            "  -> already cloned onto {} by a pre-2.0 plugin; returning index {} (1.6.8 behaviour)",
+            new_owner, existing
+        ));
+        return existing as i32;
+    }
+
+    let result = crate::api::clone_weapon_impl(new_owner.clone(), new_name, original_kind, use_original_code, true);
+    let index = result.generate_id - max_generate_id - 1;
+    log(format!(
+        "  -> weapon id {:#x}, generate id {} = {} vanilla + index {} (returned to plugin)",
+        result.weapon_id,
+        result.generate_id,
+        max_generate_id + 1,
+        index
+    ));
+    index
+}
+
+// ---------------------------------------------------------------------------------------------
+// smashline_update_weapon_count
+// ---------------------------------------------------------------------------------------------
+
+#[unsafe(naked)]
+#[no_mangle]
+pub unsafe extern "C" fn smashline_update_weapon_count() {
+    core::arch::naked_asm!(
+        "mov x3, x30",
+        "b {dispatch}",
+        dispatch = sym update_weapon_count_dispatch,
+    );
+}
+
+extern "C" fn update_weapon_count_dispatch(x0: u64, x1: u64, x2: u64, lr: u64) {
+    ensure_init();
+    let index = module_index(lr);
+    let caller = describe(index, lr);
+    let (a, b, c) = (x0 as u32 as i32, x1 as u32 as i32, x2 as u32 as i32);
+
+    let abi = match module_abi(index) {
+        Abi::Unknown => {
+            let old = plausible_weapon_kind(a) && plausible_count(b);
+            let new = plausible_generate_id(a, b) && plausible_count(c);
+            let abi = if new && !old { Abi::New } else if old { Abi::Old } else { Abi::New };
+            log(format!(
+                "update_weapon_count from {} (module ABI unknown): old reading plausible={}, 2.0 reading plausible={} -> treating as {:?}. If this is wrong, add '{} <module name>' to {}",
+                caller, old, new, abi, if abi == Abi::Old { "new" } else { "old" }, CONFIG_PATH
+            ));
+            abi
+        }
+        abi => abi,
+    };
+
+    match abi {
+        Abi::Old => {
+            log(format!(
+                "update_weapon_count [pre-2.0] from {}: weapon {} max count {}",
+                caller, weapon_label(a), b
+            ));
+            LEGACY_WEAPON_COUNT.write().insert(a, b);
+            crate::cloning::invalidate_article_cache();
+        }
+        _ => {
+            log(format!(
+                "update_weapon_count [2.0] from {}: fighter {:#x} generate id {} max count {}",
+                caller, a, b, c
+            ));
+            crate::api::update_weapon_count_impl(a, b, c);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// smashline_whitelist_kirby_copy_article
+// ---------------------------------------------------------------------------------------------
+
+#[unsafe(naked)]
+#[no_mangle]
+pub unsafe extern "C" fn smashline_whitelist_kirby_copy_article() {
+    core::arch::naked_asm!(
+        "mov x2, x30",
+        "b {dispatch}",
+        dispatch = sym whitelist_dispatch,
+    );
+}
+
+extern "C" fn whitelist_dispatch(x0: u64, x1: u64, lr: u64) {
+    ensure_init();
+    let index = module_index(lr);
+    let caller = describe(index, lr);
+    let (fighter, article) = (x0 as u32 as i32, x1 as u32 as i32);
+
+    let abi = match module_abi(index) {
+        Abi::Unknown => {
+            // Both readings are small integers, so the arguments cannot tell them apart.
+            // Default to the old meaning, which almost every existing caller uses.
+            log(format!(
+                "whitelist_kirby_copy_article from {} (module ABI unknown) -> treating as Old. If this is wrong, add 'new <module name>' to {}",
+                caller, CONFIG_PATH
+            ));
+            Abi::Old
+        }
+        abi => abi,
+    };
+
+    match abi {
+        Abi::Old => {
+            log(format!(
+                "whitelist_kirby_copy_article [pre-2.0] from {}: fighter {:#x} weapon {}",
+                caller, fighter, weapon_label(article)
+            ));
+            let mut whitelist = LEGACY_KIRBY_WHITELIST.write();
+            let list = whitelist.entry(fighter).or_default();
+            if !list.contains(&article) {
+                list.push(article);
+            }
+            drop(whitelist);
+            crate::cloning::invalidate_article_cache();
+        }
+        _ => {
+            log(format!(
+                "whitelist_kirby_copy_article [2.0] from {}: fighter {:#x} generate id {}",
+                caller, fighter, article
+            ));
+            crate::api::whitelist_kirby_copy_article_impl(fighter, article);
+        }
+    }
+}
+
+/// Called from smashline's main so the log file exists even if no moveset uses the changed APIs.
+pub fn install() {
+    ensure_init();
+}
