--- a/crates/rtld/src/lib.rs
+++ b/crates/rtld/src/lib.rs
@@ -196,6 +196,52 @@ impl ModuleObject {
         None
     }
 
+    /// Points every 64-bit import slot of `name` in this module (PLT `JUMP_SLOT` and GOT
+    /// `GLOB_DAT`/`ABS64` entries) at `replacement`. Only this module's calls are affected; the
+    /// target function itself is not modified. Slots that are not currently writable are skipped.
+    ///
+    /// Returns `(patched, skipped_read_only)`.
+    pub fn patch_imports(&mut self, replacement: *const (), name: &str) -> (usize, usize) {
+        let mut patched = 0;
+        let mut skipped = 0;
+
+        let mut patch_entry = |this: &Self, entry: Rela, allowed: &[u32]| {
+            let entry = Rel {
+                r_info: entry.r_info,
+                r_offset: entry.r_offset,
+            };
+            let ty = entry.r_type(LittleEndian);
+            if !allowed.contains(&ty) {
+                return;
+            }
+            let sym = unsafe { *this.dynsym.add(entry.r_sym(LittleEndian) as usize) };
+            if this.get_dynstr(sym.st_name.get(LittleEndian) as usize) != name {
+                return;
+            }
+            let slot = unsafe { this.module_base.add(entry.r_offset.get(LittleEndian) as usize) } as u64;
+            let info = nx::query_memory(slot);
+            // perm bit 1 = writable
+            if info.perm & 0x2 == 0 || slot + 8 > info.addr + info.size {
+                skipped += 1;
+                return;
+            }
+            unsafe { *(slot as *mut *const ()) = replacement };
+            patched += 1;
+        };
+
+        for index in 0..(self.rela_plt_size / std::mem::size_of::<Rela>()) {
+            let entry = unsafe { *self.rela_plt.add(index) };
+            patch_entry(self, entry, &[R_AARCH64_JUMP_SLOT]);
+        }
+
+        for index in self.rela_count..(self.rela_dyn_size / std::mem::size_of::<Rela>()) {
+            let entry = unsafe { *self.rela.add(index) };
+            patch_entry(self, entry, &[R_AARCH64_GLOB_DAT, R_AARCH64_ABS64]);
+        }
+
+        (patched, skipped)
+    }
+
     pub fn try_patch_reloc(&mut self, replacement: *const (), name: &str) -> Option<*const ()> {
         for index in 0..(self.rela_plt_size / std::mem::size_of::<Rela>()) {
             let entry = unsafe { *self.rela_plt.add(index) };
